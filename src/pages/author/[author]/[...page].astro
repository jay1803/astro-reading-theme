---
import { byDateDesc } from '../../../lib/sort';
import site from 'virtual:astro-reading-theme/config';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InfiniteFeed from '../../../components/InfiniteFeed.astro';
import FeedBar from '../../../components/FeedBar.astro';
import { slugifyAuthor } from '../../../lib/author';
import { t } from '../../../lib/i18n';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts');
  const byAuthor = new Map();
  const displayNames = new Map();
  for (const post of posts) {
    if (!post.data.author) continue;
    const slug = slugifyAuthor(post.data.author);
    if (!slug) continue;
    if (!byAuthor.has(slug)) byAuthor.set(slug, []);
    byAuthor.get(slug).push(post);
    if (!displayNames.has(slug)) displayNames.set(slug, post.data.author);
  }
  return [...byAuthor.entries()].flatMap(([author, authorPosts]) =>
    paginate(
      authorPosts.sort(byDateDesc),
      { params: { author }, pageSize: 12, props: { displayName: displayNames.get(author) } }
    )
  );
}

const { page, displayName } = Astro.props;
const entries = await Promise.all(
  page.data.map(async (post, i) => {
    const { Content, headings } = await render(post);
    return { post, Content, headings, num: page.total - (page.start + i) };
  })
);
---

<BaseLayout title={`${displayName} — ${site.name}`}>
  <FeedBar slot="subbar" entries={entries} total={page.total} />
  {
    page.currentPage === 1 && (
      <header class="page-head">
        <p class="page-eyebrow">{t.byAuthor(page.total, displayName)}</p>
        <h1 class="page-title">{displayName}</h1>
      </header>
    )
  }
  <InfiniteFeed entries={entries} nextUrl={page.url.next} total={page.total} />
</BaseLayout>
