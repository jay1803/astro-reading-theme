---
import site from 'virtual:astro-reading-theme/config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../lib/base';
import { t } from '../lib/i18n';
---

<BaseLayout title={`${t.offlineTitle} — ${site.name}`}>
  <section class="page-head offline">
    <h1 class="page-title">{t.offlineTitle}</h1>
    <p class="page-dek">{t.offlineBody}</p>
    <p class="offline-back"><a href={`${base}/`}>{t.offlineBack}</a></p>
  </section>
</BaseLayout>

<style>
  .offline {
    min-height: 60vh;
  }
  .offline-back {
    margin: 1.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .offline-back a {
    display: inline-block;
    padding: 0.75rem 0;
  }
</style>
