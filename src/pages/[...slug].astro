---
import site from 'virtual:astro-reading-theme/config';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListenButton from '../components/ListenButton.astro';
import FeedbackButtons from '../components/FeedbackButtons.astro';
import EntrySide from '../components/EntrySide.astro';
import PostBar from '../components/PostBar.astro';
import { base } from '../lib/base';
import { byDateDesc } from '../lib/sort';
import { readingMinutes } from '../lib/readingTime';
import { getDomain, isPrivateSourceDomain } from '../lib/domain';
import { slugifyAuthor } from '../lib/author';
import { panguSpace } from '../lib/rehype-pangu.mjs';
import { isDekRedundant } from '../lib/dedupeDek';
import { t, formatDate, entryNumber } from '../lib/i18n';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(byDateDesc);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      num: posts.length - i,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, num, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const numLabel = entryNumber(num);
const title = panguSpace(post.data.title);
const minutes = readingMinutes(post.id);
const domain = post.data.source ? getDomain(post.data.source) : null;
const showSource = Boolean(domain && !isPrivateSourceDomain(domain));
const showDek = post.data.description && !isDekRedundant(post.id, post.data.description);
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${post.data.title} — ${site.name}`} description={post.data.description}>
  <PostBar slot="subbar" num={numLabel} title={post.data.title} sections={sections} />

  <article class="post" aria-labelledby="post-title">
    <div class="post-main single-entry">
      <a class="back-link" href={`${base}/`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        {t.allEntries}
      </a>

      <p class="post-meta">
        <span>{numLabel}</span>
        {
          domain && (
            <>
              <span aria-hidden="true">·</span>
              {site.features.domain ? <a href={`${base}/domain/${domain}/`}>{domain}</a> : <span>{domain}</span>}
            </>
          )
        }
        {
          post.data.author && (
            <>
              <span aria-hidden="true">·</span>
              {site.features.author ? (
                <a href={`${base}/author/${slugifyAuthor(post.data.author)}/`}>{post.data.author}</a>
              ) : (
                <span>{post.data.author}</span>
              )}
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{t.minutes(minutes)}</span>
        <span aria-hidden="true">·</span>
        <span>{formatDate(post.data.date)}</span>
      </p>

      <h1 id="post-title" class="post-title entry-title">{title}</h1>
      {showDek && <p class="post-dek entry-dek">{panguSpace(post.data.description)}</p>}
      {site.features.listen && <ListenButton />}

      <div class="prose post-body">
        <Content />
      </div>

      {
        showSource && (
          <a class="source-card" href={post.data.source} target="_blank" rel="noopener noreferrer">
            <span class="source-text">
              <span class="source-meta">
                {domain}
                {post.data.author && ` · ${post.data.author}`}
              </span>
              <span class="source-title">{title}</span>
            </span>
            <span class="source-action">
              {t.readSource}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </span>
          </a>
        )
      }
      {
        site.features.feedback && (
          <FeedbackButtons
            slug={post.id}
            title={post.data.title}
            source={post.data.source}
            domain={domain}
            author={post.data.author}
            category={post.data.category}
            description={post.data.description}
          />
        )
      }
    </div>

    <EntrySide
      label={`${numLabel} ${t.entryInfo}`}
      date={post.data.date}
      minutes={minutes}
      domain={domain}
      author={post.data.author}
      source={post.data.source}
      headings={headings}
      offset="7.5rem"
    />
  </article>

  <nav class="post-nav" aria-label={t.postNav}>
    {
      newer ? (
        <a class="post-nav-link" href={`${base}/${newer.id}/`}>
          <span class="post-nav-label">{t.newer}</span>
          <span class="post-nav-title">{panguSpace(newer.data.title)}</span>
        </a>
      ) : (
        <a class="post-nav-link" href={`${base}/`}>
          <span class="post-nav-label">{t.back}</span>
          <span class="post-nav-title">{t.allEntries}</span>
        </a>
      )
    }
    {
      older && (
        <a class="post-nav-link is-older" href={`${base}/${older.id}/`}>
          <span class="post-nav-label">{t.older}</span>
          <span class="post-nav-title">{panguSpace(older.data.title)}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    --side-top: 6rem;
  }
  .post-main {
    min-width: 0;
    max-width: var(--measure);
    padding-top: 2.5rem;
  }
  @media (min-width: 1080px) {
    .post {
      grid-template-columns: minmax(0, var(--measure)) var(--side);
      justify-content: space-between;
      column-gap: 3rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--ink);
  }
  .back-link svg {
    width: 14px;
    height: 14px;
  }

  .post-meta {
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .post-meta a {
    text-decoration: none;
  }
  .post-meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .post-title {
    margin: 0.875rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(2.125rem, 4.6vw, 3.25rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .post-dek {
    margin: 1.5rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink-2);
  }
  :root:lang(zh) .post-dek {
    letter-spacing: 0.01em;
  }
  .post-main :global(.listen) {
    margin: 1.75rem 0 0;
  }

  .post-body {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    counter-reset: section;
  }
  /* Top-level sections get a number and title, but no rule: a rule per section made one
     article read like several. */
  .post-body > :global(h2) {
    counter-increment: section;
    margin: 4.5rem 0 1.125rem;
    font-size: 1.3em;
    line-height: 1.4;
    letter-spacing: -0.008em;
    scroll-margin-top: 7.5rem;
  }
  .post-body > :global(h2::before) {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.625rem;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .source-card {
    margin-top: 4rem;
    padding: 1.125rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    font-family: var(--font-sans);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .source-card:hover {
    border-color: var(--rule-strong);
    background: var(--surface);
  }
  .source-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .source-meta {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .source-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .source-action {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .source-action svg {
    width: 14px;
    height: 14px;
  }

  .post-nav {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0 2rem;
    border-top: 1px solid var(--rule);
  }
  .post-nav-link {
    padding: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-sans);
    color: inherit;
    text-decoration: none;
  }
  .post-nav-label {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .post-nav-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .post-nav-link:hover .post-nav-title {
    color: var(--ink-2);
  }
  @media (min-width: 640px) {
    .post-nav-link.is-older {
      text-align: right;
    }
  }
</style>
