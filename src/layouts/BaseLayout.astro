---
import { base } from '../lib/base';
import { panguSpace } from '../lib/rehype-pangu.mjs';
import { t } from '../lib/i18n';
import site from 'virtual:astro-reading-theme/config';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const target = `${base}${href}`;
  return href !== '/' && path.startsWith(target);
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1011" media="(prefers-color-scheme: dark)" />
    <title>{panguSpace(title)}</title>
    {description && <meta name="description" content={panguSpace(description)} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${base}/rss.xml`} />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
            document.documentElement.style.colorScheme = saved;
          }
        } catch (e) {}
      })();
    </script>
    {
      site.features.feedback && (
        <script is:inline data-cfasync="false">
          (function () {
            // Owner vote token: capture `#vote-token=...` on ANY page (not just posts), then strip it.
            try {
              var m = location.hash.match(/vote-token=([^&]*)/);
              if (!m) return;
              if (m[1]) localStorage.setItem('reading-vote-token', decodeURIComponent(m[1]));
              else localStorage.removeItem('reading-vote-token');
              history.replaceState(null, '', location.pathname + location.search);
            } catch (e) {}
          })();
          // Installed PWAs (esp. iOS) have their own storage and no address bar:
          // triple-tap the footer site name to paste/clear the vote token.
          document.addEventListener('DOMContentLoaded', function () {
            var el = document.querySelector('[data-owner-tap]');
            if (!el) return;
            var n = 0, timer;
            el.addEventListener('click', function () {
              n++;
              clearTimeout(timer);
              timer = setTimeout(function () { n = 0; }, 600);
              if (n < 3) return;
              n = 0;
              var cur = localStorage.getItem('reading-vote-token');
              var v = prompt(cur ? '已设置投票 token。粘贴新 token 替换，或清空后确定以移除：' : '粘贴投票 token：', '');
              if (v === null) return;
              v = v.trim();
              if (v) localStorage.setItem('reading-vote-token', v);
              else localStorage.removeItem('reading-vote-token');
              alert(v ? '已保存，刷新文章页即可看到 👍/👎' : '已移除');
              location.reload();
            });
          });
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>

    <div class="topbar">
      <header class="masthead">
        <div class="masthead-inner">
          <a class="wordmark" href={`${base}/`}>{site.name}</a>
          <nav class="masthead-nav" aria-label={t.navLabel}>
            {
              site.nav.map((item) => (
                <a class="nav-link" href={`${base}${item.href}`} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <button
              type="button"
              class="icon-btn refresh-button"
              id="refresh-button"
              title={t.refreshTitle}
              aria-label={t.refresh}
              data-msg-unavailable={t.offlineUnavailable}
              data-msg-refreshing={t.refreshing}
              data-msg-updated={t.updated}
              data-msg-failed={t.refreshFailed}
              disabled
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 11a8 8 0 1 0-2.3 5.7" />
                <path d="M20 4v7h-7" />
              </svg>
            </button>
            <a class="icon-btn" href={`${base}/rss.xml`} aria-label={t.rss}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 11a8 8 0 0 1 8 8" />
                <path d="M5 5a14 14 0 0 1 14 14" />
                <circle cx="6" cy="18" r="1.3" fill="currentColor" />
              </svg>
            </a>
            <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label={t.themeToggle}>
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
              </svg>
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
              </svg>
            </button>
          </nav>
        </div>
        <span class="refresh-status" id="refresh-status" role="status" aria-live="polite"></span>
      </header>
      <slot name="subbar" />
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <span data-owner-tap>{site.name} &nbsp;&middot;&nbsp; {site.tagline}</span>
        <span>
          {t.creditBefore}<a href="https://maxoxo.me" target="_blank" rel="noopener noreferrer">Max</a>{t.creditAfter}
        </span>
        <a href={`${base}${site.footerLink.href}`}>{site.footerLink.label}</a>
      </div>
    </footer>

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        root.style.colorScheme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-button');
      const refreshStatus = document.querySelector<HTMLElement>('#refresh-status');
      const msg = (key: string) => refreshButton?.dataset[key] ?? '';
      let statusTimer = 0;
      // Transient messages fade out; errors and progress stay until replaced.
      const setStatus = (text: string, transient = false) => {
        if (!refreshStatus) return;
        window.clearTimeout(statusTimer);
        refreshStatus.textContent = text;
        if (transient) statusTimer = window.setTimeout(() => (refreshStatus.textContent = ''), 4000);
      };

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${import.meta.env.BASE_URL}sw.js`)
            .then(() => navigator.serviceWorker.ready)
            .then(() => {
              if (refreshButton) refreshButton.disabled = false;
            })
            .catch(() => {
              setStatus(msg('msgUnavailable'), true);
              if (refreshButton) refreshButton.disabled = true;
            });
        });
      } else if (refreshButton) {
        refreshButton.disabled = true;
      }

      refreshButton?.addEventListener('click', async () => {
        if (!refreshButton) return;
        refreshButton.disabled = true;
        setStatus(msg('msgRefreshing'));
        try {
          const registration = await navigator.serviceWorker.ready;
          const worker = navigator.serviceWorker.controller || registration.active;
          if (!worker) throw new Error('Service worker unavailable');
          const channel = new MessageChannel();
          const refreshed = new Promise<void>((resolve, reject) => {
            const timeout = window.setTimeout(() => reject(new Error('Refresh timed out')), 120000);
            channel.port1.onmessage = (event) => {
              if (event.data?.progress) {
                setStatus(`${msg('msgRefreshing')} ${event.data.progress}`);
                return;
              }
              window.clearTimeout(timeout);
              channel.port1.close();
              event.data?.ok ? resolve() : reject(new Error('Refresh failed'));
            };
          });
          worker.postMessage({ type: 'REFRESH', url: location.href }, [channel.port2]);
          await refreshed;
          setStatus(msg('msgUpdated'));
          location.reload();
        } catch {
          setStatus(msg('msgFailed'));
          refreshButton.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --surface: #f7f7f8;
    --ink: #282a30;
    --text: #3c4149;
    --ink-2: #55585f;
    --ink-3: #6f6e77;
    --num: #8e8d95;
    --rule: #e9e8ea;
    --rule-strong: #d6d5d9;
    --deco: #a3a2a9;
    --mark: #e9e9ed;

    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue',
      Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', 'Noto Sans CJK SC', sans-serif;
    --font-cjk: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', 'Noto Sans CJK SC',
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-body: var(--font-sans);
    --font-mono: 'TX-02', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;

    --container: 70rem;
    --gutter: clamp(1.25rem, 3vw, 2rem);
    --measure: 42.5rem;
    --side: 14.5rem;
    --header-h: 3.75rem;

    /* 0.2.x names, kept so site pages and overrides written against them still render */
    --paper: var(--bg);
    --paper-raised: var(--surface);
    --line: var(--rule);
    --line-soft: var(--rule);
    --ink-soft: var(--ink-2);
    --ink-faint: var(--ink-3);
    --accent: var(--ink);
    --accent-soft: var(--rule-strong);
    --selection: var(--mark);
    --font-display: var(--font-sans);
    --font-em: var(--font-sans);
    --wide: var(--container);
  }
  :root:lang(zh) {
    --font-body: var(--font-cjk);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0f1011;
      --surface: #17181b;
      --ink: #ededef;
      --text: #c9cbd0;
      --ink-2: #a9acb3;
      --ink-3: #8a8f98;
      --num: #6b6f78;
      --rule: #232428;
      --rule-strong: #393b41;
      --deco: #5d6069;
      --mark: #2a2c31;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0f1011;
    --surface: #17181b;
    --ink: #ededef;
    --text: #c9cbd0;
    --ink-2: #a9acb3;
    --ink-3: #8a8f98;
    --num: #6b6f78;
    --rule: #232428;
    --rule-strong: #393b41;
    --deco: #5d6069;
    --mark: #2a2c31;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: light dark;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    /* CJK has no true italic; never let the browser fake a slant for it. */
    font-synthesis: weight small-caps;
  }

  ::selection {
    background: var(--mark);
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--deco);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration-color: currentColor;
  }
  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 30;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--bg);
    border-radius: 6px;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 0.75rem;
  }

  /* ---------- Top bar ---------- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
  }
  .masthead {
    position: relative;
    border-bottom: 1px solid var(--rule);
  }
  .masthead-inner {
    max-width: var(--container);
    min-height: var(--header-h);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
  }
  .wordmark {
    padding: 0.625rem 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-decoration: none;
  }
  .masthead-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: -10px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .nav-link {
    padding: 0.75rem 0.625rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .nav-link[aria-current='page'] {
    color: var(--ink);
  }
  .refresh-button:disabled {
    opacity: 0.45;
    cursor: default;
    background: transparent;
  }
  .icon-btn {
    width: 44px;
    height: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .icon-btn svg {
    width: 16px;
    height: 16px;
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .masthead-inner {
      flex-wrap: nowrap;
    }
    .wordmark {
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .masthead-nav {
      flex: none;
      margin-right: -8px;
    }
    .nav-link {
      padding: 0.75rem 0.4rem;
    }
    .icon-btn {
      width: 40px;
    }
  }
  .refresh-status {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    max-width: min(22rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.06);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .refresh-status:empty {
    display: none;
  }

  /* Second row of the top bar: current entry / section, opens an index. */
  .subbar {
    border-bottom: 1px solid var(--rule);
  }
  .subbar-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .subbar-btn {
    width: 100%;
    min-height: 44px;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
  }
  .subbar-badge {
    flex: none;
    min-width: 30px;
    height: 20px;
    padding: 0 6px;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    font-size: 11px;
    line-height: 18px;
    font-weight: 500;
    text-align: center;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .subbar-title {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 500;
  }
  .subbar-title.is-fixed {
    flex: 0 1 auto;
  }
  .subbar-sep {
    flex: none;
    color: var(--rule-strong);
  }
  .subbar-sub {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ink-3);
  }
  .subbar-chev {
    flex: none;
    display: inline-flex;
    color: var(--ink-3);
    transition: transform 0.2s;
  }
  .subbar-chev svg {
    width: 16px;
    height: 16px;
  }
  .subbar-btn:hover .subbar-chev {
    color: var(--ink);
  }
  .subbar-btn[aria-expanded='true'] .subbar-chev {
    transform: rotate(180deg);
  }
  .subbar-panel {
    max-height: min(70vh, 32rem);
    overflow-y: auto;
    border-top: 1px solid var(--rule);
    background: var(--surface);
  }
  .subbar-panel[hidden] {
    display: none;
  }
  .subbar-panel-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0.875rem var(--gutter) 1.125rem;
  }
  .subbar-label {
    margin: 0 0 4px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .idx-list {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .idx-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-3);
    text-decoration: none;
  }
  .idx-link::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .idx-link:hover,
  .idx-link[aria-current='true'] {
    color: var(--ink);
  }
  .idx-num {
    flex: none;
    width: 30px;
    font-variant-numeric: tabular-nums;
  }
  .idx-title {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .idx-meta {
    flex: none;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  @media (min-width: 1080px) {
    .subbar--narrow {
      display: none;
    }
  }

  main {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ---------- Page headings (stats, about, browse pages) ---------- */
  .page-head {
    max-width: var(--measure);
    padding: 5rem 0 0;
  }
  .page-eyebrow {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .page-title {
    margin: 0.75rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(2.125rem, 4.6vw, 3rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .page-dek {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text);
  }
  .section {
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .section-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .section-title {
    max-width: var(--measure);
    margin: 0.625rem 0 0.875rem;
    font-family: var(--font-sans);
    font-size: 1.375rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.008em;
    color: var(--ink);
  }
  .section-body {
    max-width: var(--measure);
    margin: 0 0 1.2em;
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--text);
  }
  :root:lang(zh) .section-body,
  :root:lang(zh) .page-dek {
    letter-spacing: 0.015em;
  }

  /* ---------- Article body ---------- */
  .prose {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--text);
    overflow-wrap: break-word;
    word-break: break-word;
  }
  :root:lang(zh) .prose {
    letter-spacing: 0.015em;
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose p {
    margin: 0 0 1.35em;
    text-wrap: pretty;
  }
  .prose > p:first-child {
    color: var(--ink);
