---
import PostEntry from './PostEntry.astro';
import { t } from '../lib/i18n';

interface Props {
  entries: { post: any; Content: any; num: number; headings?: any[] }[];
  nextUrl?: string | null;
  total?: number;
}
const { entries, nextUrl, total } = Astro.props;
---

<div class="feed" data-feed data-next-url={nextUrl ?? ''}>
  {
    entries.map(({ post, Content, num, headings }) => (
      <PostEntry post={post} Content={Content} num={num} headings={headings} />
    ))
  }

  <div class="feed-sentinel" data-sentinel></div>

  <div class="feed-skeleton" data-skeleton hidden>
    <div class="sk-line sk-num"></div>
    <div class="sk-line sk-title"></div>
    <div class="sk-line sk-body"></div>
    <div class="sk-line sk-body"></div>
    <div class="sk-line sk-body-short"></div>
  </div>

  {
    nextUrl ? (
      <a class="feed-more" data-more-link href={nextUrl}>
        {t.loadMore}
      </a>
    ) : (
      <div class="feed-end" data-end-message>
        <p class="feed-end-label">{t.endLabel}</p>
        <p class="feed-end-note">{total ? t.endNote(total) : ''}</p>
      </div>
    )
  }
</div>

<style>
  .feed > :global(.entry:first-child) {
    margin-top: 7.5rem;
  }
  .feed-sentinel {
    height: 1px;
  }

  .feed-skeleton {
    max-width: var(--measure);
    margin-top: 6rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-strong);
    animation: pulseFade 1.4s ease-in-out infinite;
  }
  .feed-skeleton[hidden] {
    display: none;
  }
  .sk-line {
    background: var(--surface);
    border-radius: 4px;
  }
  .sk-num {
    height: 48px;
    width: 96px;
    margin-bottom: 1.25rem;
  }
  .sk-title {
    height: 26px;
    width: 72%;
    margin-bottom: 1.5rem;
  }
  .sk-body {
    height: 14px;
    margin-bottom: 0.9rem;
  }
  .sk-body-short {
    height: 14px;
    width: 64%;
  }
  @keyframes pulseFade {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  .feed-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 6rem 0 0;
    padding: 0 1.125rem;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink);
    text-decoration: none;
  }
  .feed-more:hover {
    background: var(--surface);
  }

  .feed-end {
    max-width: var(--measure);
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
  }
  .feed-end-label {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .feed-end-note {
    margin: 0.375rem 0 0;
    font-size: 1rem;
    color: var(--ink-2);
  }
</style>

<script>
  function saveEntryPages(entries: Element[]) {
    if (!('serviceWorker' in navigator)) return;
    const urls = entries
      .map((entry) => entry.querySelector<HTMLAnchorElement>('.entry-title a')?.href)
      .filter((url): url is string => Boolean(url));
    if (!urls.length) return;

    navigator.serviceWorker.ready
      .then((registration) => {
        const worker = navigator.serviceWorker.controller || registration.active;
        worker?.postMessage({ type: 'CACHE_POSTS', urls });
      })
      .catch(() => {});
  }

  function initFeed(feed: HTMLElement) {
    const sentinel = feed.querySelector<HTMLElement>('[data-sentinel]');
    const skeleton = feed.querySelector<HTMLElement>('[data-skeleton]');
    const moreLink = feed.querySelector<HTMLAnchorElement>('[data-more-link]');
    if (!sentinel) return;

    let nextUrl = feed.dataset.nextUrl || '';
    let loading = false;
    saveEntryPages([...feed.querySelectorAll(':scope > .entry')]);

    async function loadNext() {
      if (loading || !nextUrl || !sentinel) return;
      loading = true;
      if (skeleton) skeleton.hidden = false;
      try {
        const res = await fetch(nextUrl);
        if (!res.ok) throw new Error(`fetch failed: ${res.status}`);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const nextFeed = doc.querySelector<HTMLElement>('[data-feed]');
        if (!nextFeed) throw new Error('no feed in response');

        const entries = [...nextFeed.querySelectorAll<HTMLElement>(':scope > .entry')];
        entries.forEach((el) => {
          sentinel && feed.insertBefore(el, sentinel);
        });
        saveEntryPages(entries);
        document.dispatchEvent(new CustomEvent('feed:append', { detail: { entries } }));

        nextUrl = nextFeed.dataset.nextUrl || '';
        feed.dataset.nextUrl = nextUrl;

        if (nextUrl) {
          if (moreLink) moreLink.href = nextUrl;
        } else {
          const endMsg = nextFeed.querySelector('[data-end-message]');
          if (endMsg) feed.appendChild(endMsg);
          moreLink?.remove();
          observer.disconnect();
          sentinel.remove();
        }
      } catch {
        // leave the manual "Load older entries" link as a fallback
      } finally {
        loading = false;
        if (skeleton) skeleton.hidden = true;
      }
    }

    const observer = new IntersectionObserver(
      (observed) => {
        if (observed.some((e) => e.isIntersecting)) loadNext();
      },
      { rootMargin: '600px 0px' }
    );
    observer.observe(sentinel);

    moreLink?.addEventListener('click', (e) => {
      e.preventDefault();
      loadNext();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-feed]').forEach(initFeed);
</script>
