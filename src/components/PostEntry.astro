---
import site from 'virtual:astro-reading-theme/config';
import { base } from '../lib/base';
import { readingMinutes } from '../lib/readingTime';
import { getDomain, isPrivateSourceDomain } from '../lib/domain';
import { slugifyAuthor } from '../lib/author';
import { panguSpace } from '../lib/rehype-pangu.mjs';
import { t, formatDate, entryNumber } from '../lib/i18n';
import EntrySide from './EntrySide.astro';

interface Props {
  post: {
    id: string;
    data: { title: string; date: Date; category: string; description?: string; source?: string; author?: string };
  };
  Content: any;
  num: number;
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, Content, num, headings = [] } = Astro.props;
const title = panguSpace(post.data.title);
const numLabel = entryNumber(num);
const minutes = readingMinutes(post.id);
const domain = post.data.source ? getDomain(post.data.source) : null;
const permalink = `${base}/${post.id}/`;
const showSource = Boolean(domain && !isPrivateSourceDomain(domain));
---

<article
  class="entry"
  id={`p-${post.id}`}
  aria-labelledby={`t-${post.id}`}
  data-entry
  data-slug={post.id}
  data-num={numLabel}
  data-title={title}
  data-minutes={t.minutes(minutes)}
>
  <div class="entry-main">
    <p class="entry-num">{numLabel}</p>
    <p class="entry-meta">
      <span>{formatDate(post.data.date)}</span>
      {
        domain && (
          <>
            <span aria-hidden="true">·</span>
            {site.features.domain ? <a href={`${base}/domain/${domain}/`}>{domain}</a> : <span>{domain}</span>}
          </>
        )
      }
      {
        post.data.author && (
          <>
            <span aria-hidden="true">·</span>
            {site.features.author ? (
              <a href={`${base}/author/${slugifyAuthor(post.data.author)}/`}>{post.data.author}</a>
            ) : (
              <span>{post.data.author}</span>
            )}
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{t.minutes(minutes)}</span>
    </p>

    <h2 class="entry-title" id={`t-${post.id}`}><a href={permalink}>{title}</a></h2>
    <p class="entry-disliked-note" aria-hidden="true">{t.disliked}</p>

    <div class="prose entry-content">
      <Content />
    </div>

    <p class="entry-links">
      {
        showSource && (
          <a href={post.data.source} target="_blank" rel="noopener noreferrer">
            {t.readSource}
          </a>
        )
      }
      <a href={permalink}>{t.permalink}</a>
    </p>
  </div>

  <EntrySide
    label={`${numLabel} ${t.entryInfo}`}
    date={post.data.date}
    minutes={minutes}
    domain={domain}
    author={post.data.author}
    source={post.data.source}
    headings={headings}
    tocBase={permalink}
  />
</article>

<script>
  // In a feed several entries can share a heading id, so section links scroll to the
  // heading inside their own entry instead of relying on the URL fragment.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('.entry a[data-toc-slug]');
    if (!link) return;
    const entry = link.closest<HTMLElement>('[data-entry]');
    const slug = link.dataset.tocSlug;
    const heading = slug ? entry?.querySelector<HTMLElement>(`[id="${CSS.escape(slug)}"]`) : null;
    if (!heading) return;
    event.preventDefault();
    heading.scrollIntoView({ block: 'start' });
  });

  // Owner-only: collapse posts Max 👎'd to just their header (feedback feature).
  // Disliked slugs are cached in localStorage (instant + offline/PWA), then refreshed
  // from /api/disliked. FeedbackButtons updates the cache when voting on a post page.
  const TOKEN_KEY = 'reading-vote-token';
  const CACHE_KEY = 'reading-disliked';
  const readCache = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(CACHE_KEY) || '[]'));
    } catch {
      return new Set();
    }
  };
  const applyDisliked = () => {
    const disliked = readCache();
    document.querySelectorAll<HTMLElement>('.entry[data-slug]').forEach((el) => {
      el.classList.toggle('entry--disliked', disliked.has(el.dataset.slug!));
    });
  };
  const token = localStorage.getItem(TOKEN_KEY);
  if (token && document.querySelector('.entry[data-slug]')) {
    applyDisliked();
    fetch('/api/disliked', { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => {
        if (!Array.isArray(d?.slugs)) return;
        localStorage.setItem(CACHE_KEY, JSON.stringify(d.slugs));
        applyDisliked();
      })
      .catch(() => {});
    document.addEventListener('feed:append', () => applyDisliked());
    // Back-navigation from a post page restores this page from bfcache: re-apply.
    window.addEventListener('pageshow', (e) => e.persisted && applyDisliked());
    // A collapsed entry's whole header opens the post.
    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      const entry = target?.closest<HTMLElement>('.entry--disliked');
      if (!entry || target?.closest('a')) return;
      const link = entry.querySelector<HTMLAnchorElement>('.entry-title a');
      if (link) location.href = link.href;
    });
  }
</script>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 6rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-strong);
    scroll-margin-top: 6.5rem;
  }
  .entry-main {
    min-width: 0;
  }
  .entry-num {
    margin: 0 0 1.25rem;
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 5vw, 4rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.045em;
    color: var(--num);
    font-variant-numeric: tabular-nums;
  }
  .entry-meta {
    margin: 0 0 0.625rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .entry-meta a {
    text-decoration: none;
  }
  .entry-meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .entry-title {
    max-width: var(--measure);
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }
  .entry-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .entry-title a:hover {
    color: var(--ink-2);
  }
  .entry-content {
    max-width: var(--measure);
    margin-top: 1.25rem;
  }
  .entry-links {
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .entry-links a {
    padding: 0.75rem 0;
  }
  .entry-disliked-note {
    display: none;
  }
  /* 👎'd by the owner: header only (number, meta, title). Post page is unchanged. */
  .entry.entry--disliked {
    margin-top: 3rem;
    cursor: pointer;
  }
  .entry--disliked .entry-num {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.5rem;
  }
  .entry--disliked .entry-content,
  .entry--disliked .entry-links,
  .entry--disliked > :global(.entry-side) {
    display: none;
  }
  .entry--disliked .entry-title a {
    color: var(--ink-3);
  }
  .entry--disliked .entry-disliked-note {
    display: block;
    margin: 0.375rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  @media (min-width: 1080px) {
    .entry.entry--disliked .entry-meta {
      display: flex;
    }
    .entry {
      grid-template-columns: minmax(0, var(--measure)) var(--side);
      justify-content: space-between;
      column-gap: 3rem;
    }
    .entry-meta {
      display: none;
    }
  }
</style>
