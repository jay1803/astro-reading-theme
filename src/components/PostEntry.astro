---
import site from 'virtual:astro-reading-theme/config';
import { base } from '../lib/base';
import { readingMinutes } from '../lib/readingTime';
import { getDomain, isPrivateSourceDomain } from '../lib/domain';
import { slugifyAuthor } from '../lib/author';
import { panguSpace } from '../lib/rehype-pangu.mjs';
import { t, formatDate, entryNumber } from '../lib/i18n';
import EntrySide from './EntrySide.astro';

interface Props {
  post: {
    id: string;
    data: { title: string; date: Date; category: string; description?: string; source?: string; author?: string };
  };
  Content: any;
  num: number;
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, Content, num, headings = [] } = Astro.props;
const title = panguSpace(post.data.title);
const numLabel = entryNumber(num);
const minutes = readingMinutes(post.id);
const domain = post.data.source ? getDomain(post.data.source) : null;
const permalink = `${base}/${post.id}/`;
const showSource = Boolean(domain && !isPrivateSourceDomain(domain));
---

<article
  class="entry"
  id={`p-${post.id}`}
  aria-labelledby={`t-${post.id}`}
  data-entry
  data-slug={post.id}
  data-num={numLabel}
  data-title={title}
  data-minutes={t.minutes(minutes)}
>
  <div class="entry-main">
    <p class="entry-num">{numLabel}</p>
    <p class="entry-meta">
      <span>{formatDate(post.data.date)}</span>
      {
        domain && (
          <>
            <span aria-hidden="true">·</span>
            {site.features.domain ? <a href={`${base}/domain/${domain}/`}>{domain}</a> : <span>{domain}</span>}
          </>
        )
      }
      {
        post.data.author && (
          <>
            <span aria-hidden="true">·</span>
            {site.features.author ? (
              <a href={`${base}/author/${slugifyAuthor(post.data.author)}/`}>{post.data.author}</a>
            ) : (
              <span>{post.data.author}</span>
            )}
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{t.minutes(minutes)}</span>
    </p>

    <h2 class="entry-title" id={`t-${post.id}`}><a href={permalink}>{title}</a></h2>
    <p class="entry-collapsed-note" aria-hidden="true" data-note-disliked={t.disliked} data-note-read={t.readCollapsed}></p>

    <div class="prose entry-content">
      <Content />
    </div>

    <p class="entry-links">
      {
        showSource && (
          <a href={post.data.source} target="_blank" rel="noopener noreferrer">
            {t.readSource}
          </a>
        )
      }
      <a href={permalink}>{t.permalink}</a>
      <button type="button" class="entry-markread" data-markread hidden>{t.markRead}</button>
    </p>
  </div>

  <EntrySide
    label={`${numLabel} ${t.entryInfo}`}
    date={post.data.date}
    minutes={minutes}
    domain={domain}
    author={post.data.author}
    source={post.data.source}
    headings={headings}
    tocBase={permalink}
  />
</article>

<script>
  // In a feed several entries can share a heading id, so section links scroll to the
  // heading inside their own entry instead of relying on the URL fragment.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('.entry a[data-toc-slug]');
    if (!link) return;
    const entry = link.closest<HTMLElement>('[data-entry]');
    const slug = link.dataset.tocSlug;
    const heading = slug ? entry?.querySelector<HTMLElement>(`[id="${CSS.escape(slug)}"]`) : null;
    if (!heading) return;
    event.preventDefault();
    heading.scrollIntoView({ block: 'start' });
  });

  // Owner-only: collapse posts Max 👎'd or marked read to just their header.
  // State is cached in localStorage (instant + offline/PWA), refreshed from /api/collapsed.
  // FeedbackButtons (post page) and the feed's 「标记已读」 button update the same caches.
  const TOKEN_KEY = 'reading-vote-token';
  const KEYS = { disliked: 'reading-disliked', read: 'reading-read' } as const;
  const readSet = (k: string): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(k) || '[]'));
    } catch {
      return new Set();
    }
  };
  const applyCollapsed = () => {
    const disliked = readSet(KEYS.disliked);
    const read = readSet(KEYS.read);
    document.querySelectorAll<HTMLElement>('.entry[data-slug]').forEach((el) => {
      const slug = el.dataset.slug!;
      const reason = disliked.has(slug) ? 'disliked' : read.has(slug) ? 'read' : '';
      el.classList.toggle('entry--collapsed', Boolean(reason));
      const note = el.querySelector<HTMLElement>('.entry-collapsed-note');
      if (note) note.textContent = reason === 'disliked' ? note.dataset.noteDisliked! : reason ? note.dataset.noteRead! : '';
      el.querySelector<HTMLElement>('[data-markread]')?.removeAttribute('hidden');
    });
  };
  const token = localStorage.getItem(TOKEN_KEY);
  if (token && document.querySelector('.entry[data-slug]')) {
    applyCollapsed();
    fetch('/api/collapsed', { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => {
        if (!Array.isArray(d?.disliked) || !Array.isArray(d?.read)) return;
        localStorage.setItem(KEYS.disliked, JSON.stringify(d.disliked));
        localStorage.setItem(KEYS.read, JSON.stringify(d.read));
        applyCollapsed();
      })
      .catch(() => {});
    document.addEventListener('feed:append', () => applyCollapsed());
    // Back-navigation from a post page restores this page from bfcache: re-apply.
    window.addEventListener('pageshow', (e) => e.persisted && applyCollapsed());
    document.addEventListener('click', async (e) => {
      const target = e.target as Element | null;
      // 「标记已读」 in the feed: save, then collapse this entry.
      const btn = target?.closest<HTMLButtonElement>('[data-markread]');
      if (btn) {
        const slug = btn.closest<HTMLElement>('.entry')?.dataset.slug;
        if (!slug) return;
        btn.disabled = true;
        const r = await fetch(`/api/read?slug=${encodeURIComponent(slug)}`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ read: true }),
        }).catch(() => null);
        btn.disabled = false;
        if (!r?.ok) {
          btn.textContent = `${btn.textContent?.replace(/（.*$/, '')}（失败）`;
          return;
        }
        const set = readSet(KEYS.read);
        set.add(slug);
        localStorage.setItem(KEYS.read, JSON.stringify([...set]));
        applyCollapsed();
        return;
      }
      // A collapsed entry's whole header opens the post.
      const entry = target?.closest<HTMLElement>('.entry--collapsed');
      if (!entry || target?.closest('a')) return;
      const link = entry.querySelector<HTMLAnchorElement>('.entry-title a');
      if (link) location.href = link.href;
    });
  }
</script>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 6rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-strong);
    scroll-margin-top: 6.5rem;
  }
  .entry-main {
    min-width: 0;
  }
  .entry-num {
    margin: 0 0 1.25rem;
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 5vw, 4rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.045em;
    color: var(--num);
    font-variant-numeric: tabular-nums;
  }
  .entry-meta {
    margin: 0 0 0.625rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .entry-meta a {
    text-decoration: none;
  }
  .entry-meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .entry-title {
    max-width: var(--measure);
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }
  .entry-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .entry-title a:hover {
    color: var(--ink-2);
  }
  .entry-content {
    max-width: var(--measure);
    margin-top: 1.25rem;
  }
  .entry-links {
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .entry-links a {
    padding: 0.75rem 0;
  }
  .entry-collapsed-note {
    display: none;
  }
  .entry-markread {
    padding: 0.75rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .entry-markread:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .entry-markread[hidden] {
    display: none;
  }
  /* 👎'd by the owner: header only (number, meta, title). Post page is unchanged. */
  .entry.entry--collapsed {
    margin-top: 3rem;
    cursor: pointer;
  }
  .entry--collapsed .entry-num {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.5rem;
  }
  .entry--collapsed .entry-content,
  .entry--collapsed .entry-links,
  .entry--collapsed > :global(.entry-side) {
    display: none;
  }
  .entry--collapsed .entry-title a {
    color: var(--ink-3);
  }
  .entry--collapsed .entry-collapsed-note {
    display: block;
    margin: 0.375rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  @media (min-width: 1080px) {
    .entry.entry--collapsed .entry-meta {
      display: flex;
    }
    .entry {
      grid-template-columns: minmax(0, var(--measure)) var(--side);
      justify-content: space-between;
      column-gap: 3rem;
    }
    .entry-meta {
      display: none;
    }
  }
</style>
